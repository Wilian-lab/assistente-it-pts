# DATABASE - RENDER
# Se usar o render.yaml, o backend pode receber DATABASE_URL automaticamente do banco gerenciado.
# Se preferir configurar manualmente, use SPRING_DATASOURCE_URL / USERNAME / PASSWORD.
DATABASE_URL=postgresql://usuario:senha@host:5432/assistant_db
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# SPRING
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# SECURITY
SECURITY_TOKEN_SECRET=gere_uma_chave_jwt_forte_e_unica_no_ambiente
SECURITY_TOKEN_EXPIRES_IN_SECONDS=28800

# ADMIN
APP_ADMIN_NAME=Administrador Sistema
APP_ADMIN_EMAIL=admin@empresa.com
APP_ADMIN_PASSWORD=defina_uma_senha_forte_no_ambiente
APP_ADMIN_SETORES=GLOBAL

# FRONTEND
APP_PASSWORD_RESET_FRONTEND_URL=https://seu-frontend.onrender.com/reset-password
VITE_API_BASE_URL=https://seu-backend.onrender.com

# MAIL
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=seu_email@gmail.com
SPRING_MAIL_PASSWORD=defina_a_senha_de_app_no_ambiente

# GEMINI API
ASSISTANT_GEMINI_API_KEY=defina_a_chave_gemini_no_ambiente

# STORAGE PERSISTENTE - RENDER
APP_STORAGE_BASE_DIR=/var/data/assistente
APP_STORAGE_PTS_EXCEL_PATH=/var/data/assistente/data/PTS_Agriproducts_02.xlsx
APP_STORAGE_IT_DIR=/var/data/assistente/docs/ITs
ASSISTANT_IT_INDEX_PATH=/var/data/assistente/data/it_index.json

# CORS
APP_SECURITY_ALLOWED_ORIGIN_PATTERNS=https://seu-frontend.onrender.com
