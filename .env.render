# DATABASE - RENDER (configure os valores reais apenas no painel do provedor)
SPRING_DATASOURCE_URL=jdbc:postgresql://SEU_HOST_RENDER:5432/assistant_db
SPRING_DATASOURCE_USERNAME=seu_usuario_render
SPRING_DATASOURCE_PASSWORD=sua_senha_render

# SPRING
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# SECURITY
SECURITY_TOKEN_SECRET=gere_uma_chave_jwt_forte_e_unica_no_ambiente
SECURITY_TOKEN_EXPIRES_IN_SECONDS=28800

# ADMIN
APP_ADMIN_NAME=Administrador Sistema
APP_ADMIN_EMAIL=admin@empresa.com
APP_ADMIN_PASSWORD=defina_uma_senha_forte_no_ambiente
APP_ADMIN_SETORES=GLOBAL

# FRONTEND
APP_PASSWORD_RESET_FRONTEND_URL=https://seu_dominio.com/reset-password
VITE_API_BASE_URL=https://seu_dominio.com/api

# MAIL
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=seu_email@gmail.com
SPRING_MAIL_PASSWORD=defina_a_senha_de_app_no_ambiente

# GEMINI API
ASSISTANT_GEMINI_API_KEY=defina_a_chave_gemini_no_ambiente
